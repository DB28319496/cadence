# Database — local dev: file:./prisma/dev.db  |  production: libsql://[name].turso.io
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-a-strong-random-string"
AUTH_URL="http://localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Email (Resend) — https://resend.com
RESEND_API_KEY=""

# File uploads (Uploadthing) — https://uploadthing.com
UPLOADTHING_TOKEN=""

# Cron job secret — protects /api/cron/* from unauthorized calls
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Anthropic API key — powers AI onboarding (questionnaire + paste-a-doc) and weekly summaries
# Get from: https://console.anthropic.com  — leave empty to hide the AI on-ramps
ANTHROPIC_API_KEY=""

# ── Switchboard setup engine (the /setup console) ──────────────────────────
# Model for config + prompt generation. Default: claude-sonnet-4-5
ANTHROPIC_MODEL=""
# Stronger model for the QA go/no-go review. Default: falls back to ANTHROPIC_MODEL
ANTHROPIC_QA_MODEL=""
# Set to "true" to use the deterministic LLM stub (no Anthropic call). Lets the
# whole pipeline run offline with zero keys — used by `pnpm itest:setup`.
SWITCHBOARD_LLM_STUB=""

# ── Phase 2: provisioning integrations ─────────────────────────────────────
# Force the deterministic provisioning stub (fake agent/number/event IDs, no
# external calls). Auto-on per-integration when that integration's key is unset.
SWITCHBOARD_PROVISION_STUB=""
# Voice agent — pick the provider per client (config.voice_provider) or default:
SWITCHBOARD_VOICE_PROVIDER=""   # retell | vapi  (default retell)
RETELL_API_KEY=""
VAPI_API_KEY=""
# Calendar
CALCOM_API_KEY=""
# Twilio (number purchase + A2P 10DLC)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# n8n broker/admin — agent function URLs + client registration
N8N_BROKER_URL=""               # base for check_availability/create_booking/notify_owner
N8N_ADMIN_URL=""                # client upsert endpoint
N8N_ADMIN_TOKEN=""
# Upstash QStash — schedules the A2P approval poll off the request path.
# When unset, A2P is polled inline (fine for stub/dev). CRON_SECRET gates the
# /api/cron/a2p-poll webhook the poll calls back into.
QSTASH_TOKEN=""

# ── Phase 3: operator access + notifications ───────────────────────────────
# Comma-separated operator emails allowed into /setup. Unset = any logged-in
# user (single-tenant dev). Also the default recipients for run notifications.
SWITCHBOARD_OPERATOR_EMAILS=""
# Fallback notification recipient when no operator allowlist is set.
OPERATOR_EMAIL=""
# Notifications use the existing RESEND_API_KEY; with no key they no-op silently.

# Field-level encryption for PII (phone numbers, etc.)
# Generate with: openssl rand -hex 32
# IMPORTANT: Back up this key — losing it means losing access to encrypted data
ENCRYPTION_KEY=""

# Upstash Redis — production-grade rate limiting (optional, falls back to in-memory)
# Get from: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
